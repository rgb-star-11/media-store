NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/mediastore?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://example.com
# Set these only for the first deployment, then remove them from the host environment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=use-a-long-unique-password
INITIAL_ADMIN_MOBILE=09120000000
MELIPAYAMAK_OTP_KEY=your-provider-key
MELIPAYAMAK_BODY_ID=123456
