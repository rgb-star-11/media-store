# Ignore node_modules everywhere
node_modules/
**/node_modules/

# Ignore build outputs
client/dist/
dist/

# Ignore environment variables & secrets
.env
*.env
server/.env

# Ignore uploaded media files
server/uploads/originals/*
!server/uploads/originals/.gitkeep
server/uploads/previews/*
!server/uploads/previews/.gitkeep

# Ignore OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
